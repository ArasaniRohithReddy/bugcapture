{
  "name": "bugcapture-server",
  "version": "0.1.0",
  "description": "Self-hostable backend for BugCapture",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "multer": "2.3.0",
    "rrweb-player": "2.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "22.16.3",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.8.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
