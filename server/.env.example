# BugCapture Server — Environment Variables
# Copy to .env and fill in values.

# Server port (default: 3000)
PORT=3000

# Directory for report storage (default: ./data)
DATA_DIR=./data

# Public-facing URL for report links (optional; when unset, relative URLs are returned).
# Example: https://bugs.example.com
PUBLIC_URL=

# ****** for authenticating upload and AI proxy requests.
# ⚠️  If unset, all endpoints are unprotected (suitable for local dev only).
AUTH_TOKEN=

# Set to "true" to require auth for read endpoints (viewer, media, raw JSON).
REQUIRE_AUTH_FOR_READ=false

# Comma-separated allowed CORS origins (default: "*").
# For Chrome extensions use: chrome-extension://YOUR_EXTENSION_ID
ALLOWED_ORIGINS=*

# Maximum total upload size in bytes (default: 200 MB = 209715200).
MAX_UPLOAD_BYTES=209715200

# Maximum single file size in bytes (default: 50 MB = 52428800).
MAX_FILE_BYTES=52428800

# AI provider: "openai", "anthropic", or "auto" (auto-detect from whichever key is set).
AI_PROVIDER=auto

# OpenAI API key (required if AI_PROVIDER=openai or auto with OpenAI).
OPENAI_API_KEY=

# Anthropic API key (required if AI_PROVIDER=anthropic or auto with Anthropic).
ANTHROPIC_API_KEY=
