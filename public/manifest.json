{
  "manifest_version": 3,
  "name": "BugCapture",
  "version": "0.1.0",
  "description": "Capture browser bugs locally with video, console, network logs and session replay.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BugCapture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "options_page": "options.html",
  "optional_host_permissions": ["*://*/*"],
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabCapture",
    "downloads",
    "offscreen"
  ],
  "commands": {
    "toggle-capture": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Start or stop a BugCapture recording"
    },
    "take-screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture an annotated screenshot"
    },
    "capture-rewind": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Save the recent BugCapture rewind buffer"
    }
  }
}
